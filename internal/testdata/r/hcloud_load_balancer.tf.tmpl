{{- /* vim: set ft=terraform: */ -}}

resource "hcloud_load_balancer" "{{ .RName }}" {
  {{/* Required properties */ -}}
  name               = "{{ .Name }}--{{ .RInt }}"
  load_balancer_type = "{{ if .Type }}{{ .Type }}{{ else }}lb11{{ end }}"
  {{- if .LocationName }}
  location           = "{{ .LocationName }}"
  {{ end }}
  {{- if .NetworkZone }}
  network_zone       = "{{ .NetworkZone }}"
  {{ end }}

  {{- /* Optional properties */}}
  {{- if .IPv4ID }}
  ipv4_id = {{ .IPv4ID }}
  {{ end }}
  {{- if .IPv6ID }}
  ipv6_id = {{ .IPv6ID }}
  {{ end }}

  {{- if .Algorithm }}
  algorithm {
    type = "{{ .Algorithm }}"
  }
  {{ end }}
  {{- range .ServerTargets }}
  target {
    type      = "server"
    server_id = {{ .ServerID }}
  }
  {{ end }}

  {{- if .Labels }}
  labels = {{ .Labels | toPrettyJson }}
  {{- end }}

  {{- if .DeleteProtection }}
  delete_protection = {{ .DeleteProtection }}
  {{ end }}
}
